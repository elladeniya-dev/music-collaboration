# Server Configuration
SERVER_PORT=8080

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/harmonix
MONGODB_DATABASE=harmonix

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-min-256-bits-long-change-this-in-production
JWT_EXPIRATION_MS=3600000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL Configuration
FRONTEND_URL=http://localhost:5173

# Application Configuration
SPRING_PROFILES_ACTIVE=dev

# Required backend vars (from properties):

# MONGODB_URI
# JWT_SECRET_KEY
# GOOGLE_CLIENT_ID
# GOOGLE_CLIENT_SECRET
# CLOUDINARY_CLOUD_NAME
# CLOUDINARY_API_KEY
# CLOUDINARY_API_SECRET
# Optional backend vars:

# SERVER_PORT
# MONGODB_DATABASE
# JWT_EXPIRATION_MS
# CORS_ALLOWED_ORIGINS
# FRONTEND_URL
# Frontend vars used:

# VITE_API_BASE_URL
# VITE_OAUTH2_URL
# VITE_WS_URL
# VITE_API_TIMEOUT (optional)
# VITE_DEBUG (optional)